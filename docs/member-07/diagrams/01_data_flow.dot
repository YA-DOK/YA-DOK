digraph G { graph [rankdir=LR, bgcolor=white, label="YA-DOK data flow | solid: reviewed code or documented auth; dashed: unverified / optional", labelloc=t, fontsize=16]; node [shape=box, style="rounded,filled", fillcolor="#e8eff5", fontname="DejaVu Sans"]; edge [fontname="DejaVu Sans",fontsize=10]; prep [label="Case preparation\nBlueprint v3.2"]; admin [label="Admin / clinical reviewer"]; student [label="Student"]; ui [label="Next.js UI"]; auth [label="Supabase Auth"]; api [label="FastAPI\nF02-F05 services"]; db [shape=cylinder,label="PostgreSQL\nprivate cases + owned sessions"]; ai [label="OpenRouter\npatient model"]; storage [shape=cylinder,label="Private Supabase Storage"]; avatar [label="Unity / voice (optional)"]; prep -> admin [style=dashed,label="synthetic JSON"]; admin -> api [label="draft / approval / publish"]; student -> ui [label="actions"]; ui -> auth [dir=both,label="login / token"]; ui -> api [dir=both,label="bearer + actions / safe responses"]; api -> auth [label="token verification"]; api -> db [dir=both,label="versions, state, events"]; api -> ai [dir=both,label="model request / reply"]; api -> storage [dir=both,label="authorized image / bytes"]; ui -> avatar [style=dashed]; }